{
  "name": "bards-library",
  "productName": "Bard's Library",
  "description": "Distraction-free desktop e-reader with synchronized ambient audio, local-first storage, and AI literary assistance",
  "author": "Bard's Library Contributors",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "tauri": "tauri",
    "package:exe": "npm run build && electron-builder --win portable",
    "package:setup": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.bardslibrary.app",
    "productName": "Bard's Library",
    "compression": "maximum",
    "electronLanguages": ["en-US"],
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "epubjs": "^0.3.93",
    "lucide-react": "^1.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
